{
  "family": "PL46",
  "style": "Fraktur",
  "units_per_em": 1000,
  "ascender": 800,
  "descender": -200,
  "cap_height": 650,
  "x_height": 450,
  "grid": 100,
  "thickness": 50,
  "left_spacing": 25,
  "right_spacing": 25,
  "source_rules": [
    {
      "source_directory": "notdef",
      "include_unencoded": true
    },
    {
      "source_directory": "ascii"
    },
    {
      "source_directory": "fraktur",
      "replace_existing": true
    },
    {
      "source_directory": "uni6771",
      "unicode_ranges": [
        [
          "6771",
          "6771"
        ]
      ]
    }
  ],
  "kerning_file": "fraktur.json"
}
