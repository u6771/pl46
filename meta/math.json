{
  "family": "PL46",
  "style": "Math",
  "weight_class": 400,
  "units_per_em": 1000,
  "ascender": 850,
  "descender": -200,
  "cap_height": 650,
  "x_height": 450,
  "grid": 100,
  "thickness": 50,
  "use_scaled_edge_thickness": true,
  "left_spacing": 75,
  "right_spacing": 75,
  "source_rules": [
    {
      "source_directory": "notdef",
      "include_unencoded": true
    },
    {
      "source_directory": "latin"
    },
    {
      "source_directory": "latin_extended"
    },
    {
      "source_directory": "greek"
    },
    {
      "source_directory": "text_symbols"
    },
    {
      "source_directory": "math",
      "include_unencoded": true,
      "replace_existing": true
    },
    {
      "source_directory": "italic",
      "mapping": "upright_latin_to_italic_latin"
    },
    {
      "source_directory": "script",
      "unicode_domain": [
        ["0041", "005A"]
      ],
      "mapping": "upright_latin_to_script_latin"
    },
    {
      "source_directory": "fraktur",
      "mapping": "upright_latin_to_fraktur_latin"
    },
    {
      "source_directory": "blackboard",
      "mapping": "upright_latin_to_blackboard_latin"
    },
    {
      "source_directory": "latin",
      "mapping": "upright_latin_to_typewriter_latin",
      "thickness_scale": 1.6,
      "monospace_width": 450
    },
    {
      "source_directory": "latin",
      "mapping": "ascii_digits_to_typewriter_digits",
      "thickness_scale": 1.6,
      "monospace_width": 450
    },
    {
      "source_directory": "bold",
      "mapping": "upright_latin_to_bold_latin"
    },
    {
      "source_directory": "bold",
      "mapping": "ascii_digits_to_bold_digits"
    },
    {
      "source_directory": "uni6771",
      "unicode_domain": [["6771"]]
    }
  ],
  "glyph_alias_generators": [
    "upright_latin_to_italic_latin",
    "upright_greek_to_italic_greek"
  ],
  "ssty_generators": [
    {
      "unicode_domain": [
        "ascii_digits",
        "bold_digits",
        "upright_latin",
        "upright_greek",
        "italic_latin",
        "italic_greek",
        "script_latin",
        "fraktur_latin",
        "bold_latin"
      ],
      "ssty_namer": "st",
      "thickness_scale": 1.2
    }
  ],
  "accent_file": "math.json",
  "ssty_file": "math.json",
  "math_table": {
    "constants_file": "math.json",
    "variants_file": "math.json",
    "italics_correction_file": "math.json",
    "accent_attachment_file": "math.json"
  },
  "glyph_config_file": "math.json",
  "release_info_file": "pl46.json"
}
